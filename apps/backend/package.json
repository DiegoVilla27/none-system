{
  "name": "@none-system/backend",
  "version": "1.0.0",
  "description": "Backend API for none-system expense and receipt management",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test:e2e": "tsx scripts/e2e-test.ts",
    "test:whatsapp": "tsx scripts/whatsapp-test.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "test": "NODE_ENV=test GEMINI_API_KEY=test-key DATABASE_URL= WHATSAPP_API_TOKEN= WHATSAPP_PHONE_NUMBER_ID= WHATSAPP_APP_SECRET=test-app-secret RESEND_API_KEY= WOMPI_PUBLIC_KEY=pub_test_testkey WOMPI_INTEGRITY_SECRET=test_integrity_secret WOMPI_EVENTS_SECRET=test_events_secret UPLOAD_DIR=.test-uploads tsx --test test/*.test.ts",
    "whatsapp:setup": "tsx scripts/whatsapp-setup.ts",
    "db:purge": "tsx scripts/purge-dev-data.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@google/genai": "^2.26.0",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.9",
    "@types/swagger-ui-express": "^4.1.8",
    "prisma": "6.19.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
