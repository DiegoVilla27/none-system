# Server Configuration
PORT=4000
NODE_ENV=development
API_PREFIX=/api/v1
# Número de proxies inversos delante del backend (para la IP real en límites de peticiones)
TRUST_PROXY=1
# Orígenes permitidos por CORS (backoffice y landing), separados por coma
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# URLs públicas usadas en mensajes del bot y enlaces legales
BACKOFFICE_URL=http://localhost:3000
LANDING_URL=http://localhost:3001

# Storage (local | s3 | supabase)
STORAGE_DRIVER=local
UPLOAD_DIR=uploads

# Gemini AI API Key (usa una cuenta de pago: en el plan gratuito Google puede usar los datos para mejorar sus modelos)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# PostgreSQL Database (Prisma) — obligatoria en producción
# Si te conectas desde la máquina host (ej: tu Mac al contenedor global_postgres):
DATABASE_URL="postgresql://user:password@localhost:5432/none_system_db?schema=public"
# Si te conectas desde otro contenedor en la misma red Docker (shared-network):
# DATABASE_URL="postgresql://user:password@global_postgres:5432/none_system_db?schema=public"

# Secretos (en producción: mínimo 32 caracteres aleatorios, ej: `openssl rand -base64 48`)
JWT_SECRET=change_me_with_openssl_rand_base64_48
# Cifra en reposo los soportes (imágenes/PDF). ¡Si cambia, los archivos existentes no se podrán leer!
ENCRYPTION_SECRET=change_me_with_openssl_rand_base64_48

# Pasarela de pagos Wompi (https://comercios.wompi.co → Desarrolladores → Llaves del API).
# Sandbox: pub_test_... | Producción: pub_prod_...
# URL de eventos a configurar en Wompi: https://<tu-dominio-o-tunel>/api/v1/payments/wompi/webhook
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
# Sin Wompi, fuera de producción el checkout es simulado (sin cobro). En producción no puede activarse.
# ALLOW_SIMULATED_PAYMENTS=true

# Correo transaccional con Resend (https://resend.com, 3.000 correos/mes gratis).
# Sin dominio verificado solo puedes enviar a tu propio correo desde onboarding@resend.dev.
RESEND_API_KEY=
EMAIL_FROM=none-system <onboarding@resend.dev>

# Meta Cloud API (WhatsApp Business)
WHATSAPP_VERIFY_TOKEN=change_me_random_verify_token
WHATSAPP_API_TOKEN=your_meta_system_user_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id_here
WHATSAPP_API_VERSION=v21.0
# App Secret de la app de Meta (Configuración > Básica). Valida la firma X-Hub-Signature-256 de cada webhook.
WHATSAPP_APP_SECRET=your_meta_app_secret_here
# Plantilla de categoría "Authentication" aprobada en Meta para enviar códigos OTP
WHATSAPP_OTP_TEMPLATE_NAME=codigo_verificacion
WHATSAPP_OTP_TEMPLATE_LANG=es

# Seed (solo para `pnpm db:seed`)
# SEED_ADMIN_EMAIL=admin@none-system.com
# SEED_ADMIN_PASSWORD=
