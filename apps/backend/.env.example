# Server Configuration
PORT=4000
NODE_ENV=development
API_PREFIX=/api/v1

# Storage (local | s3 | supabase)
STORAGE_DRIVER=local
UPLOAD_DIR=uploads

# Gemini AI API Key
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# PostgreSQL Database (Prisma)
# Si te conectas desde la máquina host (ej: tu Mac al contenedor global_postgres):
DATABASE_URL="postgresql://user:password@localhost:5432/none_system_db?schema=public"
# Si te conectas desde otro contenedor en la misma red Docker (shared-network):
# DATABASE_URL="postgresql://user:password@global_postgres:5432/none_system_db?schema=public"
JWT_SECRET=your_super_secret_jwt_key_colombia

# Meta Cloud API (WhatsApp Business)
WHATSAPP_VERIFY_TOKEN=none_system_verify_token_2026
WHATSAPP_API_TOKEN=your_meta_system_user_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id_here
WHATSAPP_API_VERSION=v21.0


