# Server Configuration
PORT=4000
NODE_ENV=development
API_PREFIX=/api/v1

# Storage (local | s3 | supabase)
STORAGE_DRIVER=local
UPLOAD_DIR=uploads

# Gemini AI API Key
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# PostgreSQL Database (Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/none_system_db?schema=public"
JWT_SECRET=your_super_secret_jwt_key_colombia

