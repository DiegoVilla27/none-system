generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String    @id @default(uuid())
  email                    String    @unique
  passwordHash             String    @map("password_hash")
  name                     String
  phoneNumber              String    @unique @map("phone_number")
  role                     String    @default("user") // user | admin | accountant
  emailVerified            Boolean   @default(false) @map("email_verified")
  // El teléfono solo se considera del usuario cuando lo demostró (OTP por WhatsApp o mensaje entrante)
  phoneVerified            Boolean   @default(false) @map("phone_verified")
  // Se incrementa al cambiar la contraseña o cerrar todas las sesiones: invalida los JWT emitidos antes
  sessionVersion           Int       @default(0) @map("session_version")
  // Mensaje de bienvenida (con imagen) enviado por WhatsApp: solo una vez por persona
  welcomeSentAt            DateTime? @map("welcome_sent_at")
  verificationToken        String?   @map("verification_token")
  verificationTokenExpires DateTime? @map("verification_token_expires")
  resetPasswordToken       String?   @map("reset_password_token")
  resetPasswordExpires     DateTime? @map("reset_password_expires")
  // Autorización de tratamiento de datos (Ley 1581 de 2012): nunca se presume
  habeasDataAccepted       Boolean   @default(false) @map("habeas_data_accepted")
  habeasDataAcceptedAt     DateTime? @map("habeas_data_accepted_at")
  habeasDataIp             String?   @map("habeas_data_ip")
  habeasDataVersion        String?   @map("habeas_data_version")
  habeasDataChannel        String?   @map("habeas_data_channel") // web | whatsapp
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  subscription       Subscription?
  expenses           Expense[]
  transactions       PaymentTransaction[]
  phoneVerifications PhoneVerification[]

  @@map("users")
}

// Códigos OTP enviados por WhatsApp (registro, verificación de número y recuperación de contraseña)
model PhoneVerification {
  id          String    @id @default(uuid())
  phoneNumber String    @map("phone_number")
  purpose     String // register | verify_phone | reset_password
  userId      String?   @map("user_id")
  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash    String    @map("code_hash")
  attempts    Int       @default(0)
  payload     Json? // Datos del registro pendiente (nunca la contraseña en claro)
  expiresAt   DateTime  @map("expires_at")
  consumedAt  DateTime? @map("consumed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([phoneNumber, purpose])
  @@map("phone_verifications")
}

model Subscription {
  id                 String   @id @default(uuid())
  userId             String?  @unique @map("user_id")
  user               User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  phoneNumber        String   @unique @map("phone_number")
  name               String?
  plan               String   @default("free") // free | basico | pro | empresarial
  monthlyLimit       Int      @default(5) @map("monthly_limit") // comprobantes con imagen/PDF por periodo
  currentUsage       Int      @default(0) @map("current_usage")
  manualUsage        Int      @default(0) @map("manual_usage") // gastos escritos registrados en el periodo
  billingCycleAnchor Int      @default(1) @map("billing_cycle_anchor") // Day of the month (1-31)
  currentPeriodStart DateTime @default(now()) @map("current_period_start")
  currentPeriodEnd   DateTime @map("current_period_end")
  status             String   @default("active") // active | suspended | canceled
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("subscriptions")
}

model Expense {
  id                   String   @id @default(uuid())
  userId               String?  @map("user_id")
  user                 User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  documentType         String   @map("document_type") // factura | transferencia | manual
  merchant             String
  financialEntity      String?  @map("financial_entity")
  taxId                String?  @map("tax_id") // NIT con dígito de verificación
  referenceNumber      String?  @map("reference_number")
  cufe                 String? // Código Único de Factura Electrónica (DIAN)
  expenseDate          String   @map("expense_date") // YYYY-MM-DD
  subtotal             Float?
  taxableBase          Float?   @map("taxable_base")
  taxAmount            Float?   @map("tax_amount")
  vat                  Float? // IVA (19% o 5%)
  consumptionTax       Float?   @map("consumption_tax") // Impuesto Nacional al Consumo INC (8%)
  total                Float // Total COP
  currency             String   @default("COP")
  category             String
  lineItems            Json     @map("line_items")
  extractionConfidence String   @default("alta") @map("extraction_confidence") // alta | media | baja
  notes                String?
  imageUrl             String?  @map("image_url") // null en gastos manuales (sin soporte)
  imageOriginalName    String?  @map("image_original_name")
  source               String   @default("web") // web | whatsapp
  fileHash             String?  @map("file_hash") // SHA-256 del soporte original: detecta reenvíos del mismo archivo
  status               String   @default("confirmado") // borrador | confirmado
  isDianCompliant      Boolean  @default(false) @map("is_dian_compliant")
  encryptedAtRest      Boolean  @default(true) @map("encrypted_at_rest")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([userId, fileHash])
  @@index([userId, total])
  @@index([imageUrl])
  @@index([expenseDate])
  @@index([documentType])
  @@map("expenses")
}

model PaymentTransaction {
  id                    String    @id @default(uuid())
  userId                String?   @map("user_id")
  user                  User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  phoneNumber           String    @map("phone_number")
  plan                  String // basico | pro | empresarial
  amountCop             Float     @map("amount_cop")
  currency              String    @default("COP")
  provider              String    @default("wompi") // wompi | simulated
  providerTransactionId String?   @unique @map("provider_transaction_id")
  paymentMethod         String?   @map("payment_method") // PSE | CARD | NEQUI | ...
  reference             String    @unique
  status                String    @default("PENDING") // PENDING | APPROVED | DECLINED | VOIDED | ERROR | SIMULATED
  customerName          String?   @map("customer_name")
  customerEmail         String?   @map("customer_email")
  customerDocNumber     String?   @map("customer_doc_number")
  paidAt                DateTime? @map("paid_at")
  planAppliedAt         DateTime? @map("plan_applied_at") // idempotencia: el plan se activa una sola vez
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at")

  @@index([phoneNumber])
  @@index([userId])
  @@map("payment_transactions")
}

// Estado de conversación del bot (DESHACER, CAMBIAR, confirmación de borrado). Persistente entre reinicios y réplicas.
model ConversationState {
  phoneNumber       String    @id @map("phone_number")
  lastActionKind    String?   @map("last_action_kind") // document | manual
  lastActionIds     String[]  @default([]) @map("last_action_ids")
  lastActionAt      DateTime? @map("last_action_at")
  pendingDeletionAt DateTime? @map("pending_deletion_at")
  // Corrección en curso del último registro (CORREGIR / CAMBIAR)
  editExpenseId     String?   @map("edit_expense_id")
  editField         String?   @map("edit_field")
  editStartedAt     DateTime? @map("edit_started_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@map("conversation_states")
}

// Mensajes de WhatsApp ya procesados: evita duplicados cuando Meta reintenta el webhook (hasta 7 días)
model ProcessedWebhookMessage {
  id          String   @id // wamid de Meta
  processedAt DateTime @default(now()) @map("processed_at")

  @@index([processedAt])
  @@map("processed_webhook_messages")
}
